<Window x:Class="IPVault.TestVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Vault Interactive Tester" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Plain Text (Proprietary)" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"/>
        <TextBlock Text="Filtered Text (LLM-Safe)" FontWeight="Bold" Grid.Row="0" Grid.Column="2" Margin="0,0,0,5"/>

        <TextBox x:Name="TxtPlain" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtPlain_TextChanged" FontFamily="Consolas" FontSize="14" />
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"/>
        <TextBox x:Name="TxtFiltered" Grid.Row="1" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtFiltered_TextChanged" FontFamily="Consolas" FontSize="14" />
    </Grid>
</Window>