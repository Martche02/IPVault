{
  "name": "ipvault-vscode",
  "displayName": "IPVault VS Code",
  "description": "Zero-Trust IP protection proxy for VS Code workspaces",
  "version": "2.0.0",
  "publisher": "Martche02",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Security",
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ipvault.generate",
        "title": "IP Vault: Generate IP Vault",
        "icon": "$(shield)"
      },
      {
        "command": "ipvault.getConfig",
        "title": "IP Vault: Get MCP Server Config",
        "icon": "$(copy)"
      },
      {
        "command": "ipvault.testInteractive",
        "title": "IP Vault: Test MCP Server (Interactive)",
        "icon": "$(terminal)"
      },
      {
        "command": "ipvault.showMenu",
        "title": "IP Vault: Show Options Menu",
        "icon": "$(shield)"
      },
      {
        "command": "ipvault.translatePrompt",
        "title": "IP Vault: Translate Prompt to Masked",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ipvault-sidebar",
          "title": "IPVault",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "ipvault-sidebar": [
        {
          "id": "ipvault-actions",
          "name": "Actions",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "ipvault.generate",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "ipvault.generate",
          "group": "navigation",
          "when": "resourceExtname == .py || resourceExtname == .sql || resourceExtname == .bat || resourceExtname == .cmd"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0"
  }
}
